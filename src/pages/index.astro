<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Support and information for the Commendo app."
    />
    <title>Commendo Support</title>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        min-height: 100vh;
        font-family:
          -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI",
          sans-serif;
        background: #fff3ed;
        color: #2b211e;
      }

      main {
        width: min(720px, calc(100% - 40px));
        margin: 0 auto;
        padding: 88px 0 56px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 48px;
        font-size: 18px;
        font-weight: 700;
      }

      .mark {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: #ff8069;
        color: white;
      }

      h1 {
        max-width: 620px;
        margin: 0;
        font-size: clamp(44px, 8vw, 72px);
        line-height: 0.98;
        letter-spacing: -0.045em;
      }

      .intro {
        max-width: 590px;
        margin: 28px 0 0;
        font-size: 20px;
        line-height: 1.55;
        color: #65544e;
      }

      .card {
        margin-top: 56px;
        padding: 30px;
        border: 1px solid rgba(43, 33, 30, 0.08);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.78);
        box-shadow: 0 18px 50px rgba(67, 39, 27, 0.08);
      }

      h2 {
        margin: 0 0 12px;
        font-size: 25px;
      }

      p {
        line-height: 1.65;
      }

      .email {
        display: inline-block;
        margin-top: 10px;
        color: #d94f3a;
        font-size: 18px;
        font-weight: 700;
        text-decoration: none;
      }

      .email:hover,
      footer a:hover {
        text-decoration: underline;
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 38px;
        font-size: 15px;
      }

      footer a {
        color: #65544e;
        text-decoration: none;
      }

      .copyright {
        width: 100%;
        margin-top: 12px;
        color: #8a7770;
        font-size: 14px;
      }

      @media (max-width: 600px) {
        main {
          padding-top: 48px;
        }

        .brand {
          margin-bottom: 38px;
        }

        .card {
          margin-top: 42px;
          padding: 24px;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <div class="brand">
        <span class="mark">C</span>
        Commendo
      </div>

      <h1>Recommendations worth acting on.</h1>

      <p class="intro">
        Commendo helps you discover books, movies, restaurants, travel
        experiences and more through trusted recommendations from people whose
        taste matters to you.
      </p>

      <section class="card">
        <h2>Commendo Support</h2>

        <p>
          Found a bug, have a question, or need help with your account? Contact
          us and we’ll get back to you as soon as possible.
        </p>

        <a class="email" href="mailto:support@commendoapp.com">
          support@commendoapp.com
        </a>

        <p>We usually respond within 1–3 business days.</p>
      </section>

      <footer>
        <a href="/privacy">Privacy Policy</a>

        <a href="/terms">Terms of Service</a>

        <a href="mailto:support@commendoapp.com">Contact Support</a>

        <div class="copyright">
          © 2026 Commendo. All rights reserved.
        </div>
      </footer>
    </main>
  </body>
</html>
